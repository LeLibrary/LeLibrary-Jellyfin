<Project Sdk="Microsoft.NET.Sdk">

  <!-- Two targets, one source tree. Jellyfin 10.11.x runs on .NET 9 and Jellyfin
       12.x on .NET 10 (verified against the NuGet packages: 10.11.x ships
       lib/net9.0, 12.x ships lib/net10.0). 10.10.x was the last net8.0 line. -->
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Jellyfin.Plugin.LeLibrary</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.LeLibrary</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

</Project>
